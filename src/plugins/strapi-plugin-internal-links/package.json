{
	"name": "@webbio/strapi-plugin-internal-links",
	"version": "3.0.1",
	"description": "A custom field for Strapi that can create internal links",
	"scripts": {
		"develop": "tsc -p tsconfig.server.json -w",
		"build": "tsc -p tsconfig.server.json && tsc -p tsconfig.admin.json",
		"prepublish": "pnpm build",
		"format": "prettier --write .",
		"spu": "pnpm up -i --latest"
	},
	"strapi": {
		"name": "internal-links",
		"description": "A custom field that can create a URL based on an internal relation",
		"displayName": "Internal Link",
		"kind": "plugin"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/webbio/strapi-plugin-internal-links.git"
	},
	"dependencies": {
		"@strapi/design-system": "1.19.0",
		"@strapi/helper-plugin": "4.26.2",
		"@strapi/icons": "1.19.0",
		"@strapi/typescript-utils": "4.26.2",
		"@strapi/utils": "4.26.2",
		"cheerio": "^1.0.0-rc.12",
		"fuse.js": "^7.0.0",
		"lodash": "^4.17.21",
		"qs": "6.11.1",
		"react-intl": "6.4.1",
		"react-query": "3.39.3",
		"react-select": "^5.7.4",
		"yup": "0.32.9"
	},
	"devDependencies": {
		"@babel/preset-react": "^7.22.15",
		"@types/lodash": "^4.14.165",
		"@types/react": "^18.2.21",
		"@types/react-dom": "^18.2.7",
		"@types/react-router-dom": "^5.3.3",
		"@types/styled-components": "^5.1.26",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-router-dom": "^5.3.4",
		"styled-components": "^5.3.6",
		"typescript": "^5.2.2"
	},
	"peerDependencies": {
		"@strapi/strapi": "^4.26.2",
		"react": "^17.0.0 || ^18.0.0",
		"react-dom": "^17.0.0 || ^18.0.0",
		"react-router-dom": "^5.3.4",
		"styled-components": "^5.3.6"
	},
	"author": {
		"name": "Webbio B.V.",
		"email": "info@webbio.nl",
		"url": "https://webbio.nl"
	},
	"maintainers": [
		{
			"name": "Webbio B.V.",
			"email": "info@webbio.nl",
			"url": "https://webbio.nl"
		}
	],
	"engines": {
		"node": ">=18.0.0"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	}
}
