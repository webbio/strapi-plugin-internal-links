{
	"name": "strapi-plugin-internal-links",
	"private": true,
	"version": "0.1.0",
	"description": "A Strapi application",
	"packageManager": "pnpm@11.13.0",
	"scripts": {
		"dev": "strapi develop",
		"start": "strapi start",
		"build": "pnpm build-internal-links && strapi build",
		"build-internal-links": "pnpm --filter @webbio/strapi-plugin-internal-links build",
		"watch": "strapi develop --watch-admin",
		"strapi": "strapi",
		"debug": "node --inspect ./node_modules/@strapi/strapi/bin/strapi develop",
		"format": "prettier --write .",
		"lint": "eslint .",
		"test": "jest --runInBand --passWithNoTests",
		"db:start": "docker-compose up -d",
		"db:stop": "docker-compose down",
		"postinstall": "node ./scripts/postinstall.js",
		"spu": "pnpm up -i --latest",
		"publish-plugin": "pnpm --filter @webbio/strapi-plugin-internal-links publish"
	},
	"dependencies": {
		"@strapi/plugin-graphql": "4.26.2",
		"@strapi/plugin-i18n": "4.26.2",
		"@strapi/plugin-users-permissions": "4.26.2",
		"@strapi/strapi": "4.26.2",
		"@webbio/strapi-plugin-tiptap": "^0.0.32",
		"better-sqlite3": "11.10.0",
		"mysql": "^2.18.1",
		"react": "^18.0.0",
		"react-dom": "^18.0.0",
		"react-router-dom": "^5.2.0",
		"styled-components": "^5.2.1"
	},
	"devDependencies": {
		"@babel/preset-react": "^7.23.3",
		"@strapi/typescript-utils": "4.26.2",
		"@webbio/eslint-config-strapi": "^1.1.7",
		"@webbio/prettier-config": "^0.0.8",
		"eslint": "^8.33.0",
		"husky": "^8.0.3",
		"jest": "^29.7.0",
		"lint-staged": "^14.0.1",
		"prettier": "^3.0.3",
		"typescript": "^5.2.2"
	},
	"prettier": "@webbio/prettier-config",
	"author": {
		"name": "A Strapi developer"
	},
	"strapi": {
		"uuid": "6df721a2-7b9d-45a7-b40a-3e0753bb4644"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"license": "MIT"
}
